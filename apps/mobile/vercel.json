{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ../.. && pnpm install --filter @matrimonial/mobile... --no-frozen-lockfile && pnpm --filter @matrimonial/shared build && cd apps/mobile && NODE_OPTIONS='--max-old-space-size=6144' pnpm expo export --platform web",
  "outputDirectory": "dist",
  "installCommand": "echo 'install handled in buildCommand'",
  "framework": null,
  "env": {
    "EXPO_PUBLIC_ENV": "preview",
    "EXPO_PUBLIC_API_URL": "https://matrimonialserver-production.up.railway.app",
    "EXPO_PUBLIC_CHAT_URL": "wss://matrimonialserver-production.up.railway.app",
    "EXPO_PUBLIC_MEDIA_URL": "https://matrimonialserver-production.up.railway.app"
  },
  "rewrites": [
    {
      "source": "/((?!_expo|assets|favicon|manifest\\.json|sw\\.js|icons).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Service-Worker-Allowed", "value": "/" },
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" }
      ]
    }
  ]
}
