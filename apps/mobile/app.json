{
  "expo": {
    "name": "matrimonial",
    "slug": "matrimonial",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "matrimonial",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.matrimonial.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f43f5e"
      },
      "package": "com.matrimonial.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": ["expo-router"],
    "extra": {
      "EXPO_PUBLIC_CHAT_URL": "http://localhost:3002"
    }
  }
}
