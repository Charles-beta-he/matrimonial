# ========== Preview environment (Railway + Supabase + Upstash) ==========
NODE_ENV=preview
PORT=3000
LOG_LEVEL=info

# Database — Supabase (Session Mode via Supavisor)
# Get from: Dashboard → ⚙ Settings → Database → Connection string → URI
# Use Session Mode (port 5432) NOT Transaction Mode (port 6543) — Prisma needs
# prepared statements which Transaction Mode disables.
# Username format: postgres.<PROJECT_REF>  Host: aws-0-<REGION>.pooler.supabase.co
DATABASE_URL=postgresql://postgres.__PROJECT_REF__:__PASSWORD__@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require&connection_limit=10&pool_timeout=20

# Redis — Upstash
# Get from: upstash.com → Database → Connect → redis-cli
REDIS_URL=rediss://default:__UPSTASH_PASSWORD__@__HOST__.upstash.io:6379

# Server URL (auto-set by Railway)
SERVER_URL=${RAILWAY_PUBLIC_DOMAIN}

# CORS — Vercel deployment URLs
CORS_ORIGINS=https://matrimonial-h5.vercel.app,https://matrimonial-admin.vercel.app

# JWT — generate with: openssl rand -base64 32
JWT_SECRET=__CHANGE_ME_RUN_openssl_rand_base64_32__

# ========== Downgraded features (preview only) ==========
# Microservices merged into main API
RECOMMEND_SERVICE_URL=
CHAT_SERVICE_URL=
MEDIA_SERVICE_URL=

# LiveKit — disabled in preview (no free WebRTC SFU)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WS_URL=

# ========== Optional third-parties ==========
# Leave blank to use mock fallback
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# SMS/OSS/Verify/Audit — all leave blank for mock
