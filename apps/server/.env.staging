NODE_ENV=staging
PORT=3000
DATABASE_URL=postgresql://matrimonial:__STAGING_DB_PASSWORD__@staging-db:5432/matrimonial_staging
REDIS_URL=redis://staging-redis:6379
JWT_SECRET=__STAGING_JWT_SECRET__
CORS_ORIGINS=https://staging.matrimonial.example.com,https://staging-admin.matrimonial.example.com
SERVER_URL=https://api-staging.matrimonial.example.com
LOG_LEVEL=info

RECOMMEND_SERVICE_URL=http://recommend-service:8000
CHAT_SERVICE_URL=http://chat-service:3002
MEDIA_SERVICE_URL=http://media-service:3003

LIVEKIT_API_KEY=__STAGING_LIVEKIT_KEY__
LIVEKIT_API_SECRET=__STAGING_LIVEKIT_SECRET__
LIVEKIT_WS_URL=wss://livekit-staging.matrimonial.example.com

ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_API_KEY injected via secret manager

OSS_BUCKET=matrimonial-staging
OSS_REGION=oss-cn-hangzhou
CDN_DOMAIN=https://cdn-staging.matrimonial.example.com
