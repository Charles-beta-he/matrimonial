{
  "name": "@matrimonial/server",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./trpc": "./src/trpc/index.ts"
  },
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "type-check": "tsc --noEmit -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx src/prisma/seed.ts"
  },
  "dependencies": {
    "@matrimonial/shared": "workspace:*",
    "@nestjs/common": "^11.0.12",
    "@nestjs/core": "^11.0.12",
    "@nestjs/platform-express": "^11.0.12",
    "@prisma/client": "^6.6.0",
    "@trpc/server": "^11.0.0",
    "express": "^5.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.24.2",
    "jose": "^6.0.8",
    "ioredis": "^5.6.0",
    "express-rate-limit": "^7.5.0",
    "pino": "^9.6.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@matrimonial/config": "workspace:*",
    "@nestjs/cli": "^11.0.5",
    "@nestjs/schematics": "^11.0.5",
    "@types/express": "^5.0.1",
    "@types/node": "^22.14.0",
    "@vitest/coverage-v8": "^3.1.1",
    "prisma": "^6.6.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.1.1"
  },
  "prisma": {
    "schema": "src/prisma/schema.prisma",
    "seed": "tsx src/prisma/seed.ts"
  }
}
