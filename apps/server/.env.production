NODE_ENV=production
PORT=3000
# All sensitive values below are placeholders — replaced by secret manager (K8s Secret / AWS SSM / Aliyun KMS)
DATABASE_URL=postgresql://matrimonial:__PROD_DB_PASSWORD__@prod-db:5432/matrimonial_prod
REDIS_URL=redis://prod-redis:6379
JWT_SECRET=__PROD_JWT_SECRET__
CORS_ORIGINS=https://app.matrimonial.com,https://admin.matrimonial.com
SERVER_URL=https://api.matrimonial.com
LOG_LEVEL=info

RECOMMEND_SERVICE_URL=http://recommend-service:8000
CHAT_SERVICE_URL=http://chat-service:3002
MEDIA_SERVICE_URL=http://media-service:3003

LIVEKIT_API_KEY=__PROD_LIVEKIT_KEY__
LIVEKIT_API_SECRET=__PROD_LIVEKIT_SECRET__
LIVEKIT_WS_URL=wss://livekit.matrimonial.com

ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=__PROD_ANTHROPIC_KEY__

# Aliyun SMS
ALIYUN_SMS_ACCESS_KEY_ID=__PROD_ALIYUN_KEY__
ALIYUN_SMS_ACCESS_KEY_SECRET=__PROD_ALIYUN_SECRET__
ALIYUN_SMS_SIGN_NAME=婚恋
ALIYUN_SMS_TEMPLATE_CODE=SMS_XXXXXX

# Aliyun OSS
OSS_ACCESS_KEY_ID=__PROD_OSS_KEY__
OSS_ACCESS_KEY_SECRET=__PROD_OSS_SECRET__
OSS_BUCKET=matrimonial-prod
OSS_REGION=oss-cn-hangzhou
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
CDN_DOMAIN=https://cdn.matrimonial.com

# Aliyun Real-name
ALIYUN_VERIFY_APP_CODE=__PROD_VERIFY_CODE__

# Aliyun Content Audit
ALIYUN_GREEN_ACCESS_KEY_ID=__PROD_GREEN_KEY__
ALIYUN_GREEN_ACCESS_KEY_SECRET=__PROD_GREEN_SECRET__

# WeChat Pay
WECHAT_APP_ID=__PROD_WECHAT_APPID__
WECHAT_MCH_ID=__PROD_WECHAT_MCHID__
WECHAT_API_V3_KEY=__PROD_WECHAT_APIV3__
WECHAT_PRIVATE_KEY=__PROD_WECHAT_PRIVKEY__
WECHAT_CERT_SERIAL_NO=__PROD_WECHAT_SERIAL__
WECHAT_NOTIFY_URL=https://api.matrimonial.com/webhooks/wechat-pay

# Alipay
ALIPAY_APP_ID=__PROD_ALIPAY_APPID__
ALIPAY_PRIVATE_KEY=__PROD_ALIPAY_PRIVKEY__
ALIPAY_PUBLIC_KEY=__PROD_ALIPAY_PUBKEY__
ALIPAY_NOTIFY_URL=https://api.matrimonial.com/webhooks/alipay

# JPush
JPUSH_APP_KEY=__PROD_JPUSH_KEY__
JPUSH_MASTER_SECRET=__PROD_JPUSH_SECRET__
